# ==========================================================================
# Personal Attention Engine - environment configuration
# ==========================================================================
# Copy this file to `.env` and fill in the values you have.
#   cp .env.example .env      (macOS / Linux / Git Bash)
#   copy .env.example .env    (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
#
# The app runs WITHOUT any of these values set. Gmail features require the
# Google values; AI analysis is optional (a deterministic analyzer is used).
# ==========================================================================


# --------------------------------------------------------------------------
# 1. SERVER
# --------------------------------------------------------------------------

# Port for the backend API.
PORT=8787

# "development" | "production" | "test"
NODE_ENV=development

# Public URL of the WEB APP. Used to build the Google OAuth redirect target
# back into your app after consent.
#   - dev (Vite): http://localhost:5173
#   - prod (served by the API server): http://localhost:8787
WEB_APP_URL=http://localhost:5173

# Secret used to sign the OAuth "state" cookie and session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank in development (a random value is generated at startup).
SESSION_SECRET=


# --------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 / GMAIL API
# --------------------------------------------------------------------------
# How to obtain these: https://console.cloud.google.com/
#   1. Create (or pick) a project.
#   2. Enable the "Gmail API" for that project.
#   3. Configure the OAuth consent screen.
#   4. Go to "APIs & Services" > "Credentials" > "Create credentials" >
#      "OAuth client ID" > Application type: "Web application".
#   5. Add this Authorized redirect URI:
#        http://localhost:8787/api/auth/google/callback
#
# Then either:
#   (a) put the credentials file next to the project root, or
#   (b) copy the values into the two variables below.
# ---------------------------------------------------------------------------

# Path to a Google OAuth client credentials JSON file you downloaded.
# Leave blank if you prefer to use GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below.
GOOGLE_CREDENTIALS_PATH=

# From the OAuth client page. Web application credentials have no redirect
# URIs embedded in them; you configure those in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scope is fixed at gmail.readonly and cannot be widened. There is deliberately
# no variable here: see SECURITY.md.

# Skip the consent screen for your own Google account during development.
# Set to true only if you created an "External" app in "Testing" mode and
# added your own account as a test user.
GOOGLE_SKIP_CONSENT_SCREEN=false


# --------------------------------------------------------------------------
# 3. AI PROVIDER  (optional)
# --------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works: OpenAI, Groq,
# Together, OpenRouter, DeepSeek, or a local Ollama / LM Studio server.
#
# If these are blank, the app uses its deterministic built-in analyzer.
# Nothing is ever sent to a remote model without AI_API_KEY being set.
# --------------------------------------------------------------------------

# e.g. sk-...            (OpenAI / Groq / Together)
#      gsk_...            (Groq)
#      http://localhost:11434/v1   (Ollama - may need no real key)
AI_API_KEY=

# e.g. https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1

# e.g. gpt-4o-mini, llama-3.1-8b-instant, qwen2.5:7b
AI_MODEL=gpt-4o-mini

# "ai"        - always use the AI provider, fail loudly if unavailable
# "hybrid"    - AI for uncertain emails, deterministic rules for clear ones
# "off"       - never call the AI, deterministic analyzer only
AI_MODE=hybrid

# Max emails sent to the AI per analysis run (keeps cost predictable).
AI_MAX_CALLS_PER_RUN=60

# Seconds to wait for a model response before giving up and using the rules.
AI_TIMEOUT_MS=25000

# Sampling temperature. Keep this low: the engine wants consistent judgements,
# not variety.
AI_TEMPERATURE=0.1


# --------------------------------------------------------------------------
# 4. ATTENTION ENGINE TUNING
# --------------------------------------------------------------------------

# How many recent messages to pull from Gmail per analysis run.
# Keep this small. Do not scan the whole mailbox.
ANALYSIS_MESSAGE_LIMIT=100

# Minimum engine confidence before an item is surfaced in the feed.
ATTENTION_MIN_CONFIDENCE=0.55

# Notifications: "off" | "high" (high priority only) | "all"
NOTIFY_MODE=high


# --------------------------------------------------------------------------
# 5. STORAGE
# --------------------------------------------------------------------------

# Directory for the local SQLite database. Keep it OUTSIDE version control.
DATA_DIR=./data

# Optional: how long analysed messages are retained before re-analysis (days).
# 0 = forever.
CACHE_TTL_DAYS=0


# --------------------------------------------------------------------------
# 6. ADVANCED (leave blank unless you need them)
# --------------------------------------------------------------------------

# Characters of email body stored locally per message, and sent to the AI.
# Both exist to bound what leaves the machine and what lands on disk. Lowering
# these makes analysis slightly less accurate on long emails.
BODY_EXCERPT_CHARS=600
AI_EXCERPT_CHARS=900

# Gmail search query used to pick which messages to fetch. The default skips
# promotions and your own sent mail, which is where the noise is.
GMAIL_QUERY=in:anywhere -category:promotions -is:sent

# debug | info | warn | error
LOG_LEVEL=info
